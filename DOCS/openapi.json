        "properties": {
          "by_scenario": {
            "items": {
              "$ref": "#/components/schemas/ScenarioResult"
            },
            "type": "array",
            "title": "By Scenario"
          },
          "twin_weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Twin Weights"
          },
          "primary_twin": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Twin"
          },
          "sim_config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sim Config"
          }
        },
        "type": "object",
        "required": [
          "by_scenario",
          "twin_weights",
          "sim_config"
        ],
        "title": "SimulateResponse"
      },
      "TwinChatRequest": {
        "properties": {
          "twin_id": {
            "type": "string",
            "title": "Twin Id"
          },
          "history": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "History"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "conditioning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Conditioning"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "twin_id",
          "prompt"
