            "type": "string",
            "title": "User Id"
          },
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "title": "Ts"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          },
          "task": {
            "type": "string",
            "enum": [
              "choose_product",
              "refine",
              "stop",
              "nav_action"
            ],
            "title": "Task"
          },
          "action_id": {
            "type": "string",
            "title": "Action Id"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "session_id",
          "ts",
          "context",
          "task",
          "action_id"
        ],
        "title": "CTAStep"
      },
      "Candidate": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
