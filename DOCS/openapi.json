        "title": "MatchResponse"
      },
      "Mixture": {
        "properties": {
          "auto_from_cta": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Auto From Cta"
          },
          "weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
