            "type": "array",
            "title": "Candidates"
          },
          "max_tokens": {
            "type": "integer",
            "title": "Max Tokens",
            "default": 20
          },
          "conditioning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Conditioning"
