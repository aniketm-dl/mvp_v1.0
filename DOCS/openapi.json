          "explain": {
            "type": "string",
            "enum": [
              "none",
              "blend",
              "per_twin"
            ],
            "title": "Explain",
            "default": "none"
          },
          "deterministic": {
            "type": "boolean",
            "title": "Deterministic",
            "default": true
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 17
          },
          "mixture": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mixture"
              },
              {
                "type": "null"
