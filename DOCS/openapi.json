            "type": "object",
            "title": "Deltas"
          }
        },
        "type": "object",
        "required": [
          "variant_id",
          "topN"
        ],
        "title": "ScenarioResult"
      },
      "SimulateRequest": {
        "properties": {
          "cta_seq": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CTAStep"
                },
                "type": "array"
              },
