        "title": "TwinChatRequest"
      },
      "TwinChatResponse": {
        "properties": {
          "twin_id": {
            "type": "string",
            "title": "Twin Id"
          },
          "reply": {
            "type": "string",
            "title": "Reply"
          }
        },
        "type": "object",
        "required": [
          "twin_id",
          "reply"
        ],
        "title": "TwinChatResponse"
      },
      "TwinDecideRequest": {
        "properties": {
          "twin_id": {
            "type": "string",
            "title": "Twin Id"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
