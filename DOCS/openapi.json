            "$ref": "#/components/schemas/TwinDecision"
          }
        },
        "type": "object",
        "required": [
          "twin_id",
          "decision"
        ],
        "title": "TwinDecideResponse"
      },
      "TwinDecision": {
        "properties": {
          "pick": {
            "type": "string",
            "title": "Pick"
          },
          "why": {
            "type": "string",
            "title": "Why"
          }
        },
        "type": "object",
        "required": [
          "pick",
          "why"
        ],
        "title": "TwinDecision"
      },
      "TwinPick": {
        "properties": {
          "twin_id": {
            "type": "string",
            "title": "Twin Id"
          },
          "picks": {
            "items": {
              "additionalProperties": true,
              "type": "object"
