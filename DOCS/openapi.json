        "additionalProperties": false,
        "type": "object",
        "required": [
          "variant_id"
        ],
        "title": "ScenarioPatch"
      },
      "ScenarioResult": {
        "properties": {
          "variant_id": {
            "type": "string",
            "title": "Variant Id"
          },
          "topN": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Topn"
          },
          "why": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why"
          },
          "by_twin": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TwinPick"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "By Twin"
          },
          "deltas": {
            "additionalProperties": {
              "type": "number"
