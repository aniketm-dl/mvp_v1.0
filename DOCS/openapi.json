            "title": "Psychographic Tags"
          },
          "demographic_profile": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Demographic Profile"
          }
        },
        "type": "object",
        "title": "Conditioning"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
