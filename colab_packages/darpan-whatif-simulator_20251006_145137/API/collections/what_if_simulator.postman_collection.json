{
  "info": {
    "name": "Darpan What-If Simulator",
    "_postman_id": "darpan-what-if",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Ready",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ready"
      }
    },
    {
      "name": "Live",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/live"
      }
    },
    {
      "name": "Versions",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/versions"
      }
    },
    {
      "name": "List Personas",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/twin/personas"
      }
    },
    {
      "name": "Twin Chat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"twin_id\":\"k0\",\n  \"history\":[],\n  \"prompt\":\"What do you value?\",\n  \"conditioning\": {\"psychographic_tags\":[\"speed_focus\"]}\n}"
        },
        "url": "{{baseUrl}}/twin/chat"
      }
    },
    {
      "name": "Twin Decide",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"twin_id\":\"k0\",\n  \"context\":{\"page_type\":\"search\",\"visible_products\":[\"A1\",\"A2\"],\"delivery_eta_days\":2},\n  \"candidates\":[{\"id\":\"A1\"},{\"id\":\"A2\"}],\n  \"max_tokens\":20,\n  \"conditioning\": {\"psychographic_tags\":[\"thrift\"]}\n}"
        },
        "url": "{{baseUrl}}/twin/decide"
      }
    },
    {
      "name": "Simulate (blend reason)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cta_seq\": [{\n    \"user_id\":\"u1\",\"session_id\":\"s1\",\"ts\":\"2025-06-01T12:00:00\",\n    \"context\":{\"page_type\":\"search\",\"visible_products\":[\"A1\",\"A2\",\"A3\"],\"promo_badge\":true,\"delivery_eta_days\":2},\n    \"task\":\"choose_product\",\"action_id\":\"A2\"\n  }],\n  \"task\":\"choose_product\",\n  \"scenarios\":[{\"variant_id\":\"base\",\"context_overrides\":{}},{\"variant_id\":\"promo\",\"context_overrides\":{\"promo_badge\":true}}],\n  \"deterministic\": true,\n  \"seed\": 17,\n  \"explain\": \"blend\"\n}"
        },
        "url": "{{baseUrl}}/simulate"
      }
    },
    {
      "name": "Admin: Create Pin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"demo\",\n  \"weights\": {\"k0\":0.5, \"k1\":0.5}\n}"
        },
        "url": "{{baseUrl}}/admin/pin"
      }
    },
    {
      "name": "Admin: List Pins",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/admin/pins"
      }
    },
    {
      "name": "Simulate (use pin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cta_seq\": [{\n    \"user_id\":\"u1\",\"session_id\":\"s1\",\"ts\":\"2025-06-01T12:00:00\",\n    \"context\":{\"page_type\":\"search\",\"visible_products\":[\"A1\",\"A2\",\"A3\"],\"promo_badge\":true,\"delivery_eta_days\":2},\n    \"task\":\"choose_product\",\"action_id\":\"A2\"\n  }],\n  \"task\":\"choose_product\",\n  \"scenarios\":[{\"variant_id\":\"base\",\"context_overrides\":{}}],\n  \"deterministic\": true,\n  \"seed\": 17,\n  \"use_pin\": \"demo\",\n  \"explain\": \"per_twin\"\n}"
        },
        "url": "{{baseUrl}}/simulate"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminToken",
      "value": "changeme"
    }
  ]
}
