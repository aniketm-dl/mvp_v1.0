# AWS Credentials Reference - EXAMPLE FILE
# ==========================================
# This is a template file. DO NOT add real credentials here!
# Copy this file to .aws_credentials_reference.txt and add your real credentials there.
#
# cp .aws_credentials_reference.txt.example .aws_credentials_reference.txt
#
# The actual .aws_credentials_reference.txt file is in .gitignore and will not be committed.

AWS Access Key ID:
YOUR_AWS_ACCESS_KEY_ID_HERE

AWS Secret Access Key:
YOUR_AWS_SECRET_ACCESS_KEY_HERE

AWS Region:
ap-south-1 (Mumbai, Asia) or your preferred region

# Configuration Location:
# ~/.aws/credentials
# ~/.aws/config

# S3 Bucket for Training:
# s3://your-bucket-name-here

# To use these credentials:
# 1. Install AWS CLI: https://aws.amazon.com/cli/
# 2. Run: aws configure
# 3. Enter the values above when prompted

# To verify setup:
# aws sts get-caller-identity
# aws s3 ls

# For more information:
# https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html

# SECURITY BEST PRACTICES:
# - Never commit real credentials to git
# - Rotate credentials regularly
# - Use IAM roles with minimum required permissions
# - Enable MFA on your AWS account
